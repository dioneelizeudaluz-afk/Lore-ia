{
  "version": 2,
  "builds": [
    {
      "src": "package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "dist"
      }
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ],
  "env": {
    "VITE_GITHUB_CLIENT_ID": "@github-client-id",
    "VITE_GITHUB_REDIRECT_URI": "@github-redirect-uri"
  }
}
